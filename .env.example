# ==========================================
# AI Tool Discovery Platform Environment Config
# ==========================================

# Supabase Public API Endpoint (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Public API Key (Required for client-side Auth & queries)
# NOTE: Never put your service_role secret here!
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Application Canonical Base URL (Used for OAuth redirects, Sitemap, and SEO)
NEXT_PUBLIC_APP_URL=http://localhost:3000
